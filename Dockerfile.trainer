ARG TRAINER_BASE_IMAGE=python:3.12-slim
FROM ${TRAINER_BASE_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp \
    DEBIAN_FRONTEND=noninteractive

WORKDIR /app

COPY pyproject.toml requirements.txt requirements-trainer.in requirements-trainer.txt ./
COPY data/wheelhouse /wheelhouse
RUN pip install --no-index --find-links=/wheelhouse \
    "torch==2.7.1+cu126" \
    "torchvision==0.22.1+cu126" \
    -r requirements.txt \
    -r requirements-trainer.txt

COPY README.md ./
COPY src ./src
RUN pip install --no-index --find-links=/wheelhouse --no-deps .

CMD ["agentforge", "trainer"]
